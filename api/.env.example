# --- SAP (endpoints <SAP_BASE_URL>/poletech/salespole/salespole_<recurso>) ---
# Base SEM a parte /poletech/..., ex.: https://apiqas.sap.sladm.com.br/sap/bc/apis_pole
SAP_BASE_URL=https://apiqas.sap.sladm.com.br/sap/bc/apis_pole
# Deixe SAP_CLIENT comentado (mandante padrao, como no Postman). So preencha se
# precisar de outro mandante: um valor errado causa 401 "Logon Error".
# SAP_CLIENT=
SAP_USER=
# Use aspas se a senha tiver # ou espacos: SAP_PASSWORD="minha#senha"
SAP_PASSWORD=
SAP_TIMEOUT_MS=60000

# --- Supabase (use a SERVICE ROLE key; nunca exponha no app) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- API ---
PORT=3000
# liga/desliga os jobs agendados de sincronizacao com o SAP
SYNC_ENABLED=true
