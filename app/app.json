{
  "expo": {
    "name": "Sales Pole",
    "slug": "salespole",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.polealimentos.salespole"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.polealimentos.salespole"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      ["expo-image-picker", { "cameraPermission": "O Sales Pole usa a câmera para fotografar a fachada do cliente na visita." }],
      ["expo-location", { "locationWhenInUsePermission": "O Sales Pole usa a sua localização para confirmar que você está no cliente ao iniciar a visita." }]
    ],
    "scheme": "salespole"
  }
}
