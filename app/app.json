{
  "expo": {
    "name": "SalesPole",
    "slug": "salespole",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.polealimentos.salespole"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.polealimentos.salespole",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O SalesPole usa a câmera para fotografar a fachada do cliente na visita."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SalesPole usa a sua localização para confirmar que você está no cliente ao iniciar a visita."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "scheme": "salespole",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7099ccb-28af-443c-9139-e024423f317b"
      }
    },
    "owner": "polealimentoss-team"
  }
}
