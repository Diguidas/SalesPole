# URL da API NestJS acessivel PELO CELULAR.
# Em desenvolvimento: IP do seu computador na rede Wi-Fi (ex.: http://192.168.0.10:3000).
# "localhost" nao funciona no celular.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Projeto Supabase (Settings > API). Use a chave "anon"/publishable, NUNCA a service role.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
